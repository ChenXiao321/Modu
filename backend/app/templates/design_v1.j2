{# ============================================================================ #}
{# Prompt Template: ASPICE Level 2 Design Document Generation                   #}
{# ============================================================================ #}
{# Role: 你是一名汽车电子软件架构师，负责根据需求生成 ASPICE Level 2 设计文档。      #}
{# Input:                                                                         #}
{#   - requirements: 结构化需求列表 (含 requirement_id, description, asil_level)   #}
{#   - safety_parameters: 安全关键参数列表                                          #}
{#   - asil_level: 模块 ASIL 等级 (A/B/C/D/QM)                                     #}
{#   - filename: 输入文件名                                                        #}
{# Output: JSON 格式，必须包含以下 8 个章节，每章必须有 polarion_trace_id：          #}
{#   - overview, references, system_architecture, interface_definition             #}
{#   - dynamic_behavior, resource_consumption, error_handling, test_strategy       #}
{# Constraint:                                                                    #}
{#   - ASIL 等级必须与输入需求声明一致                                              #}
{#   - 每个章节必须包含至少一个 Polarion 追溯 ID                                    #}
{#   - 必须包含概述、架构、接口定义、动态行为、错误处理、测试策略六个章节           #}
{# ============================================================================ #}

{% set effective_asil = asil_level or "QM" %}
{% set base_trace = "POL-DSGN-%03d"|format(seed % 1000) %}
{% set coverage_target = 90 if effective_asil == "B" else 80 %}
{% set req_summary = requirements[:3] %}
{% set param_summary = safety_parameters[:3] %}

{
  "overview": {
    "content": "本文档描述基于 {{ filename }} 的软件模块设计方案。\n模块 ASIL 等级声明: ASIL-{{ effective_asil }}。\n设计目标: 实现芯片手册定义的功能需求，满足车规级安全与可靠性要求。",
    "polarion_trace_id": "{{ base_trace }}-001"
  },
  "references": {
    "content": "[1] 上游输入文档: 芯片手册 / 需求规格\n[2] AUTOSAR Classic Platform 标准 (R20-11)\n[3] MISRA C:2012 编码规范\n[4] ASPICE Level 2 过程要求",
    "polarion_trace_id": "{{ base_trace }}-002"
  },
  "system_architecture": {
    "content": "模块采用分层架构设计:\n- 应用层: 实现业务逻辑与状态机\n- 服务层: 封装硬件访问接口\n- MCAL 层: 通过标准化接口调用微控制器驱动\n安全机制: 针对 ASIL-{{ effective_asil }} 等级注入看门狗监控与冗余检查。",
    "polarion_trace_id": "{{ base_trace }}-003"
  },
  "interface_definition": {
    "content": "公共接口:\n- Modu_<Module>_Init(void): 模块初始化\n- Modu_<Module>_MainFunction(void): 周期主函数\n- Modu_<Module>_GetVersionInfo(Std_VersionInfoType* versioninfo): 版本查询\n回调接口: 通过配置结构体注入，便于单元测试 Mock。",
    "polarion_trace_id": "{{ base_trace }}-004"
  },
  "dynamic_behavior": {
    "content": "状态机定义:\n- INIT: 上电初始化，配置寄存器为安全默认值\n- RUNNING: 正常业务处理周期\n- SAFE_STATE: 故障检测后进入安全状态\n状态转换由外部事件或内部超时触发，转换条件在配置头文件中定义。",
    "polarion_trace_id": "{{ base_trace }}-005"
  },
  "resource_consumption": {
    "content": "资源消耗估算 (TC38x 目标):\n- ROM: ~8 KB (代码 + 常量表)\n- RAM: ~2 KB (全局变量 + 运行时缓冲区)\n- 堆栈: 最大深度估计 512 字节\n- CPU 负载: 主函数周期 10ms，单次执行 < 500 µs",
    "polarion_trace_id": "{{ base_trace }}-006"
  },
  "error_handling": {
    "content": "错误处理策略:\n- 检测到电压异常: 触发 SAFE_STATE，记录 DTC\n- 看门狗超时: 触发系统复位\n- 非法寄存器访问: 返回 E_NOT_OK，不上报致命错误\n所有错误处理路径均具备独立的测试覆盖。",
    "polarion_trace_id": "{{ base_trace }}-007"
  },
  "test_strategy": {
    "content": "测试策略覆盖:\n- 单元测试: 基于 Mock/Stub 环境，覆盖所有公共接口\n- 边界测试: 数值型参数最小值、最大值、典型值\n- 故障注入: 通信超时、电源异常、看门狗复位\n覆盖率目标: 语句 ≥ {{ coverage_target }}%，分支 ≥ 80%。",
    "polarion_trace_id": "{{ base_trace }}-008"
  }
}
